        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <userSettings>
        <OxyPlayer_WPF.OxySettings>
            <setting name="FileCount" serializeAs="String">
                <value>-1</value>
            </setting>
