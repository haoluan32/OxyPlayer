<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="OxyPlayer_WPF.palette" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
            <section name="OxyPlayer_WPF.OxySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <userSettings>
        <OxyPlayer_WPF.palette>
            <setting name="BackgroundColor" serializeAs="String">
                <value>White</value>
            </setting>
            <setting name="TextColor" serializeAs="String">
                <value>Black</value>
            </setting>
            <setting name="PrimaryColor" serializeAs="String">
                <value>DodgerBlue</value>
            </setting>
            <setting name="SecondaryColor" serializeAs="String">
                <value>LightSteelBlue</value>
            </setting>
            <setting name="ErrorBackgroundColor" serializeAs="String">
                <value>Red</value>
            </setting>
        </OxyPlayer_WPF.palette>
        <OxyPlayer_WPF.OxySettings>
            <setting name="FileCount" serializeAs="String">
                <value>-1</value>
            </setting>
            <setting name="DesktopLyricsFont" serializeAs="String">
                <value>宋体, 18pt</value>
            </setting>
            <setting name="DesktopLyricsColor" serializeAs="String">
                <value>Black</value>
            </setting>
            <setting name="Opacity" serializeAs="String">
                <value>1</value>
            </setting>
            <setting name="ShownDesklopLyrics" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="LockDesktopLyrics" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="DesktopLyricsLocation" serializeAs="String">
                <value>0, 0</value>
            </setting>
            <setting name="MusicFolderPath" serializeAs="String">
                <value />
            </setting>
            <setting name="ShowStartup" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ExitWhenFormClosing" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Volume" serializeAs="String">
                <value>1</value>
            </setting>
            <setting name="RandomPlay" serializeAs="String">
                <value>False</value>
            </setting>
        </OxyPlayer_WPF.OxySettings>
    </userSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>