<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="OxyPlayer.Palette" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
            <section name="OxyPlayer.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
            <section name="OxyPlayer.OxySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <connectionStrings>
        <add name="OxyPlayer.Properties.Settings.SongsConnectionString"
            connectionString="Data Source=|DataDirectory|\Songs.sdf" providerName="Microsoft.SqlServerCe.Client.3.5" />
    </connectionStrings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/></startup><userSettings>
        <OxyPlayer.Palette>
            <setting name="ActivedColor" serializeAs="String">
                <value>80, 160, 255</value>
            </setting>
            <setting name="ControlerBackgroudColor" serializeAs="String">
                <value>LightCyan</value>
            </setting>
            <setting name="PlaylistBackgroudColor" serializeAs="String">
                <value />
            </setting>
        </OxyPlayer.Palette>
        <OxyPlayer.Properties.Settings>
            <setting name="SongPath" serializeAs="String">
                <value />
            </setting>
        </OxyPlayer.Properties.Settings>
        <OxyPlayer.OxySettings>
            <setting name="FileCount" serializeAs="String">
                <value>-1</value>
            </setting>
            <setting name="DesktopLyricsFont" serializeAs="String">
                <value>宋体, 18pt</value>
            </setting>
            <setting name="DesktopLyricsColor" serializeAs="String">
                <value>Black</value>
            </setting>
            <setting name="Opacity" serializeAs="String">
                <value>1</value>
            </setting>
            <setting name="ShownDesklopLyrics" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="LockDesktopLyrics" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="DesktopLyricsLocation" serializeAs="String">
                <value>0, 0</value>
            </setting>
            <setting name="MusicFolderPath" serializeAs="String">
                <value />
            </setting>
            <setting name="ShowStartup" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="ExitWhenFormClosing" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Volume" serializeAs="String">
                <value>1</value>
            </setting>
            <setting name="RandomPlay" serializeAs="String">
                <value>False</value>
            </setting>
        </OxyPlayer.OxySettings>
    </userSettings>
</configuration>
